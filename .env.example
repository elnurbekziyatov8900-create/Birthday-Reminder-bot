BOT_TOKEN=123456:ABC-your-bot-token
BOT_ACCESS_PASSWORD=change_this_password
POSTGRES_PASSWORD=change_this_db_password
# Docker ichida host "db", lokal ishga tushirishda "localhost:5437"
DATABASE_URL=postgresql+asyncpg://birthday_user:change_this_db_password@db:5432/birthday_db
# Superguruh ID si "-100" bilan boshlanadi. Guruh ichida /chatid orqali bilib oling.
TARGET_GROUP_ID=-1001234567890
ADMIN_USER_IDS=123456789
TIMEZONE=Asia/Tashkent
BIRTHDAY_REMINDER_TIME=09:00
LEAP_DAY_POLICY=february_28
LOG_LEVEL=INFO
